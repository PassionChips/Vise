# Repo-wide ignore rules. App-specific rules live in vise-app/.gitignore.

# ── Local databases (contain personal financial data — never commit) ──
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# ── Secrets / environment ──
.env
.env.*
!.env.example

# ── Rust build output ──
target/
**/*.rs.bk

# ── JavaScript dependencies ──
node_modules/

# ── Python ──
__pycache__/
*.pyc
.venv/

# ── Logs ──
*.log

# ── OS files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── Editors / IDEs ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Local AI-assistant files (agents, skills, instructions): personal tooling, not part of the app ──
.claude/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.agents/
.agent/
skills-lock.json
.mcp.json

# ── Build outputs and packages (rebuilt by CI or locally, never committed) ──
*.apk
*.aab
*.ap_
*.dex
*.so
*.a
*.o
*.dylib
*.xcframework/
*.ipa
dist/
build/
.gradle/
.cxx/
.externalNativeBuild/
captures/
DerivedData/
Pods/
*.tgz

# ── Signing keys and credentials ──
*.keystore
*.jks
*.p12
*.p8
*.pem
*.key
*.mobileprovision
google-services.json
GoogleService-Info.plist
secrets.*
*.secret

# ── Test, coverage and tooling output ──
coverage/
.nyc_output/
*.lcov
junit.xml
.vitest/
.eslintcache
.tsbuildinfo
*.tsbuildinfo

# ── Local scratch, backups and logs ──
tmp/
temp/
scratch/
*.bak
*.orig
*.rej
*.tmp
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Other local AI / editor assistants ──
.cursor/
.cursorrules
.aider*
.continue/
.windsurf/
.codex/
.gemini/
GEMINI.md
