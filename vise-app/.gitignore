# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
# Generic rules (databases, .env, target/, node_modules/, OS/editor files) are in the root .gitignore.

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Python analytics virtualenv
python-analytics/.venv/

# Native Rust libraries built by scripts/build-*-core.sh
modules/vise-core/android/src/main/jniLibs/
modules/vise-core/ios/*.a
