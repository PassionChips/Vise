{
  "expo": {
    "name": "VISE",
    "slug": "vise-app",
    "scheme": "vise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070b09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.reborn_lvl.viseapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": "VISE uses the camera to read your receipts. The photo is read on your phone and never uploaded.",
          "photosPermission": "VISE reads receipts you choose. The photo is read on your phone and never uploaded."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#070b09",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#070b09"
          }
        }
      ]
    ],
    "backgroundColor": "#070b09"
  }
}
